# Copy to `.env` for local development. Real values never go into Git.
# The full contract is in docs/INTEGRATIONS.md §9.

# development | test | production
NODE_ENV=development

# Local port (Render sets PORT itself in production)
PORT=4000

# Local PostgreSQL from docker-compose.yml (host port 5434)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/mani_dev

# Integration tests use their own database. Its name must end in "_test".
# WARNING: the test setup drops and recreates this database on every run.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5434/mani_test

# Optional: an empty scratch database Prisma may wipe, only for `npm run db:check-drift`
# SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/mani_shadow

# Exact browser origins allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Number of proxies in front of the app (required in production; measured in Phase 3)
TRUST_PROXY_HOPS=0
