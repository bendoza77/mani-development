// Database schema. Design and reasoning: docs/DATABASE_DESIGN.md.
// The connection URL lives in prisma.config.ts (Prisma 7).
//
// Conventions:
// - UUID primary keys, generated by Prisma (time-ordered v7).
// - snake_case tables and columns in PostgreSQL, camelCase in TypeScript.
// - Bilingual text: `xKa` is required (Georgian is primary), `xEn` and `xRu` are optional (null = fall back: Russian → English → Georgian).
// - Integrity rules Prisma can't express are CHECK constraints in the migration SQL.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Authentication (§3.1) ────────────────────────────────────────────────

model AdminUser {
  id                String    @id @default(uuid(7)) @db.Uuid
  email             String    @unique @db.VarChar(254)
  name              String    @db.VarChar(100)
  passwordHash      String    @map("password_hash")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      AdminSession[]
  resetTokens   PasswordResetToken[]
  activity      ActivityLog[]
  uploadedMedia MediaAsset[]

  @@map("admin_users")
}

model AdminSession {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  userAgent  String?  @map("user_agent") @db.VarChar(400)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Media (§3.2) ─────────────────────────────────────────────────────────

enum MediaKind {
  IMAGE
  VIDEO

  @@map("media_kind")
}

enum MediaProvider {
  CLOUDFLARE_IMAGES
  CLOUDFLARE_STREAM
  STATIC

  @@map("media_provider")
}

enum MediaStatus {
  PENDING
  PROCESSING
  READY
  FAILED

  @@map("media_status")
}

enum MediaCategory {
  exterior
  interior
  construction
  team
  uploads

  @@map("media_category")
}

model MediaAsset {
  id              String        @id @default(uuid(7)) @db.Uuid
  kind            MediaKind     @default(IMAGE)
  provider        MediaProvider
  providerKey     String        @map("provider_key") @db.VarChar(300)
  status          MediaStatus   @default(PENDING)
  filename        String        @db.VarChar(255)
  altKa           String        @map("alt_ka") @db.VarChar(300)
  altEn           String?       @map("alt_en") @db.VarChar(300)
  altRu           String?       @map("alt_ru") @db.VarChar(300)
  category        MediaCategory @default(uploads)
  width           Int
  height          Int
  bytes           Int
  mimeType        String        @map("mime_type") @db.VarChar(100)
  durationSeconds Int?          @map("duration_seconds")
  uploadedById    String?       @map("uploaded_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  uploadedBy AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  projectCovers    Project[]           @relation("ProjectCover")
  projectOgImages  Project[]           @relation("ProjectOgImage")
  projectGallery   ProjectImage[]
  serviceImages    Service[]
  teamPhotos       TeamMember[]
  blockUses        ContentBlockMedia[]
  slides           HomeSlide[]
  pageOgImages     Page[]              @relation("PageOgImage")
  settingsOgImages SiteSettings[]      @relation("SettingsOgImage")

  @@unique([provider, providerKey])
  @@index([status, category, createdAt(sort: Desc)])
  @@index([uploadedById])
  @@map("media_assets")
}

// ─── Projects (§3.3) ──────────────────────────────────────────────────────

enum ProjectCategory {
  residential
  apartments
  commercial
  hospitality
  renovation

  @@map("project_category")
}

enum ProjectStatus {
  planning
  in_progress @map("in-progress")
  completed
  on_hold     @map("on-hold")

  @@map("project_status")
}

model Project {
  id                  String          @id @default(uuid(7)) @db.Uuid
  slug                String          @unique @db.VarChar(80)
  titleKa             String          @map("title_ka") @db.VarChar(120)
  titleEn             String?         @map("title_en") @db.VarChar(120)
  titleRu             String?         @map("title_ru") @db.VarChar(120)
  summaryKa           String          @map("summary_ka") @db.VarChar(180)
  summaryEn           String?         @map("summary_en") @db.VarChar(180)
  summaryRu           String?         @map("summary_ru") @db.VarChar(180)
  descriptionKa       String          @map("description_ka") @db.Text
  descriptionEn       String?         @map("description_en") @db.Text
  descriptionRu       String?         @map("description_ru") @db.Text
  locationKa          String          @map("location_ka") @db.VarChar(120)
  locationEn          String?         @map("location_en") @db.VarChar(120)
  locationRu          String?         @map("location_ru") @db.VarChar(120)
  cityKa              String          @map("city_ka") @db.VarChar(80)
  cityEn              String?         @map("city_en") @db.VarChar(80)
  cityRu              String?         @map("city_ru") @db.VarChar(80)
  category            ProjectCategory
  status              ProjectStatus
  progress            Int             @db.SmallInt
  startDate           DateTime        @map("start_date") @db.Date
  estimatedCompletion DateTime        @map("estimated_completion") @db.Date
  completionDate      DateTime?       @map("completion_date") @db.Date
  featured            Boolean         @default(false)
  architect           String          @default("") @db.VarChar(120)
  coverId             String          @map("cover_id") @db.Uuid
  isPublished         Boolean         @default(false) @map("is_published")
  publishedAt         DateTime?       @map("published_at") @db.Timestamptz(3)

  // Shared SEO fields (§3.9)
  seoTitleKa       String  @default("") @map("seo_title_ka") @db.VarChar(70)
  seoTitleEn       String? @map("seo_title_en") @db.VarChar(70)
  seoTitleRu       String? @map("seo_title_ru") @db.VarChar(70)
  seoDescriptionKa String  @default("") @map("seo_description_ka") @db.VarChar(200)
  seoDescriptionEn String? @map("seo_description_en") @db.VarChar(200)
  seoDescriptionRu String? @map("seo_description_ru") @db.VarChar(200)
  ogImageId        String? @map("og_image_id") @db.Uuid
  robotsIndex      Boolean @default(true) @map("robots_index")
  robotsFollow     Boolean @default(true) @map("robots_follow")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cover        MediaAsset     @relation("ProjectCover", fields: [coverId], references: [id], onDelete: Restrict)
  ogImage      MediaAsset?    @relation("ProjectOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  gallery      ProjectImage[]
  specs        ProjectSpec[]
  blocks       ContentBlock[]
  testimonials Testimonial[]

  @@index([coverId])
  @@index([ogImageId])
  @@index([isPublished, updatedAt(sort: Desc)])
  @@map("projects")
}

model ProjectImage {
  projectId String @map("project_id") @db.Uuid
  mediaId   String @map("media_id") @db.Uuid
  position  Int    @db.SmallInt

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([projectId, position])
  @@unique([projectId, mediaId])
  @@index([mediaId])
  @@map("project_images")
}

model ProjectSpec {
  id        String  @id @default(uuid(7)) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  position  Int     @db.SmallInt
  labelKa   String  @map("label_ka") @db.VarChar(60)
  labelEn   String? @map("label_en") @db.VarChar(60)
  labelRu   String? @map("label_ru") @db.VarChar(60)
  valueKa   String  @map("value_ka") @db.VarChar(120)
  valueEn   String? @map("value_en") @db.VarChar(120)
  valueRu   String? @map("value_ru") @db.VarChar(120)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, position])
  @@map("project_specs")
}

// ─── Services and team (§3.4) ─────────────────────────────────────────────

model Service {
  id            String   @id @default(uuid(7)) @db.Uuid
  slug          String   @unique @db.VarChar(80)
  titleKa       String   @map("title_ka") @db.VarChar(80)
  titleEn       String?  @map("title_en") @db.VarChar(80)
  titleRu       String?  @map("title_ru") @db.VarChar(80)
  summaryKa     String   @map("summary_ka") @db.VarChar(200)
  summaryEn     String?  @map("summary_en") @db.VarChar(200)
  summaryRu     String?  @map("summary_ru") @db.VarChar(200)
  descriptionKa String   @map("description_ka") @db.VarChar(2000)
  descriptionEn String?  @map("description_en") @db.VarChar(2000)
  descriptionRu String?  @map("description_ru") @db.VarChar(2000)
  featuresKa    String[] @default([]) @map("features_ka")
  featuresEn    String[] @default([]) @map("features_en")
  featuresRu    String[] @default([]) @map("features_ru")
  imageId       String   @map("image_id") @db.Uuid
  visible       Boolean  @default(true)
  position      Int
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  image MediaAsset @relation(fields: [imageId], references: [id], onDelete: Restrict)

  @@index([position])
  @@index([imageId])
  @@map("services")
}

model TeamMember {
  id        String   @id @default(uuid(7)) @db.Uuid
  nameKa    String   @map("name_ka") @db.VarChar(100)
  nameEn    String?  @map("name_en") @db.VarChar(100)
  nameRu    String?  @map("name_ru") @db.VarChar(100)
  roleKa    String   @map("role_ka") @db.VarChar(100)
  roleEn    String?  @map("role_en") @db.VarChar(100)
  roleRu    String?  @map("role_ru") @db.VarChar(100)
  bioKa     String   @map("bio_ka") @db.VarChar(600)
  bioEn     String?  @map("bio_en") @db.VarChar(600)
  bioRu     String?  @map("bio_ru") @db.VarChar(600)
  photoId   String   @map("photo_id") @db.Uuid
  visible   Boolean  @default(true)
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  photo MediaAsset @relation(fields: [photoId], references: [id], onDelete: Restrict)

  @@index([position])
  @@index([photoId])
  @@map("team_members")
}

// ─── Testimonials (§3.5) ──────────────────────────────────────────────────

model Testimonial {
  id        String   @id @default(uuid(7)) @db.Uuid
  quoteKa   String   @map("quote_ka") @db.VarChar(400)
  quoteEn   String?  @map("quote_en") @db.VarChar(400)
  quoteRu   String?  @map("quote_ru") @db.VarChar(400)
  authorKa  String   @map("author_ka") @db.VarChar(100)
  authorEn  String?  @map("author_en") @db.VarChar(100)
  authorRu  String?  @map("author_ru") @db.VarChar(100)
  roleKa    String   @map("role_ka") @db.VarChar(100)
  roleEn    String?  @map("role_en") @db.VarChar(100)
  roleRu    String?  @map("role_ru") @db.VarChar(100)
  projectId String?  @map("project_id") @db.Uuid
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([published, createdAt(sort: Desc)])
  @@index([projectId])
  @@map("testimonials")
}

// ─── Inquiries, notes, notifications (§3.6) ───────────────────────────────

enum InquiryStatus {
  new
  in_progress @map("in-progress")
  resolved

  @@map("inquiry_status")
}

model Inquiry {
  id        String        @id @default(uuid(7)) @db.Uuid
  name      String        @db.VarChar(100)
  email     String        @db.VarChar(254)
  phone     String?       @db.VarChar(40)
  subject   String        @db.VarChar(120)
  message   String        @db.VarChar(5000)
  status    InquiryStatus @default(new)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  notes         InquiryNote[]
  notifications Notification[]

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("inquiries")
}

model InquiryNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  inquiryId String   @map("inquiry_id") @db.Uuid
  text      String   @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
  @@map("inquiry_notes")
}

enum NotificationType {
  NEW_INQUIRY

  @@map("notification_type")
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  type      NotificationType
  inquiryId String           @map("inquiry_id") @db.Uuid
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([inquiryId])
  @@map("notifications")
}

// ─── Activity log (§3.7) ──────────────────────────────────────────────────

enum ActivityKind {
  project
  inquiry
  service
  testimonial
  team
  media
  settings
  auth
  page
  navigation
  slide
  redirect

  @@map("activity_kind")
}

model ActivityLog {
  id        String       @id @default(uuid(7)) @db.Uuid
  kind      ActivityKind
  message   String       @db.VarChar(300)
  actorId   String?      @map("actor_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@map("activity_log")
}

// ─── Site settings (§3.8) ─────────────────────────────────────────────────

model SiteSettings {
  id          Int     @id @default(1) @db.SmallInt
  companyName String  @map("company_name") @db.VarChar(24)
  taglineKa   String  @map("tagline_ka") @db.VarChar(40)
  taglineEn   String? @map("tagline_en") @db.VarChar(40)
  taglineRu   String? @map("tagline_ru") @db.VarChar(40)
  email       String  @db.VarChar(254)
  phone       String  @db.VarChar(40)
  addressKa   String  @map("address_ka") @db.VarChar(200)
  addressEn   String? @map("address_en") @db.VarChar(200)
  addressRu   String? @map("address_ru") @db.VarChar(200)
  hoursKa     String  @map("hours_ka") @db.VarChar(100)
  hoursEn     String? @map("hours_en") @db.VarChar(100)
  hoursRu     String? @map("hours_ru") @db.VarChar(100)

  instagramUrl String @default("") @map("instagram_url") @db.VarChar(300)
  linkedinUrl  String @default("") @map("linkedin_url") @db.VarChar(300)
  facebookUrl  String @default("") @map("facebook_url") @db.VarChar(300)

  whatsappNumber    String   @default("") @map("whatsapp_number") @db.VarChar(20)
  messengerUsername String   @default("") @map("messenger_username") @db.VarChar(100)
  mapUrl            String   @default("") @map("map_url") @db.VarChar(500)
  latitude          Decimal? @db.Decimal(9, 6)
  longitude         Decimal? @db.Decimal(9, 6)

  defaultSeoDescriptionKa String  @default("") @map("default_seo_description_ka") @db.VarChar(300)
  defaultSeoDescriptionEn String? @map("default_seo_description_en") @db.VarChar(300)
  defaultSeoDescriptionRu String? @map("default_seo_description_ru") @db.VarChar(300)
  defaultOgImageId        String? @map("default_og_image_id") @db.Uuid
  googleSiteVerification  String  @default("") @map("google_site_verification") @db.VarChar(100)
  gtmContainerId          String  @default("") @map("gtm_container_id") @db.VarChar(20)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  defaultOgImage MediaAsset? @relation("SettingsOgImage", fields: [defaultOgImageId], references: [id], onDelete: SetNull)

  @@index([defaultOgImageId])
  @@map("site_settings")
}

// ─── Pages, blocks, preview tokens (§3.9) ─────────────────────────────────

enum PageKind {
  SYSTEM
  CUSTOM

  @@map("page_kind")
}

enum SystemPageKey {
  home
  projects
  services
  about
  contact

  @@map("system_page_key")
}

model Page {
  id          String         @id @default(uuid(7)) @db.Uuid
  kind        PageKind       @default(CUSTOM)
  systemKey   SystemPageKey? @unique @map("system_key")
  slug        String         @unique @db.VarChar(80)
  titleKa     String         @map("title_ka") @db.VarChar(120)
  titleEn     String?        @map("title_en") @db.VarChar(120)
  titleRu     String?        @map("title_ru") @db.VarChar(120)
  introKa     String         @default("") @map("intro_ka") @db.VarChar(400)
  introEn     String?        @map("intro_en") @db.VarChar(400)
  introRu     String?        @map("intro_ru") @db.VarChar(400)
  /// Page colors chosen in the editor: { background, textColor, accent } as #rrggbb or null.
  style       Json           @default("{}")
  isPublished Boolean        @default(false) @map("is_published")
  publishedAt DateTime?      @map("published_at") @db.Timestamptz(3)

  seoTitleKa       String  @default("") @map("seo_title_ka") @db.VarChar(70)
  seoTitleEn       String? @map("seo_title_en") @db.VarChar(70)
  seoTitleRu       String? @map("seo_title_ru") @db.VarChar(70)
  seoDescriptionKa String  @default("") @map("seo_description_ka") @db.VarChar(200)
  seoDescriptionEn String? @map("seo_description_en") @db.VarChar(200)
  seoDescriptionRu String? @map("seo_description_ru") @db.VarChar(200)
  ogImageId        String? @map("og_image_id") @db.Uuid
  robotsIndex      Boolean @default(true) @map("robots_index")
  robotsFollow     Boolean @default(true) @map("robots_follow")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ogImage  MediaAsset?      @relation("PageOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  blocks   ContentBlock[]
  navItems NavigationItem[]

  @@index([ogImageId])
  @@map("pages")
}

enum BlockType {
  heading
  text
  image
  gallery
  video
  embed
  banner
  textImage @map("text-image")
  cards

  @@map("block_type")
}

model ContentBlock {
  id        String    @id @default(uuid(7)) @db.Uuid
  pageId    String?   @map("page_id") @db.Uuid
  projectId String?   @map("project_id") @db.Uuid
  position  Int       @db.SmallInt
  type      BlockType
  data      Json

  page    Page?               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  project Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   ContentBlockMedia[]

  @@index([pageId, position])
  @@index([projectId, position])
  @@map("content_blocks")
}

model ContentBlockMedia {
  blockId  String @map("block_id") @db.Uuid
  mediaId  String @map("media_id") @db.Uuid
  position Int    @db.SmallInt

  block ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  media MediaAsset   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([blockId, position])
  @@index([mediaId])
  @@map("content_block_media")
}

model PreviewToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  targetType String    @map("target_type") @db.VarChar(10)
  targetId   String    @map("target_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("preview_tokens")
}

// ─── Navigation (§3.10) ───────────────────────────────────────────────────

enum NavLocation {
  HEADER
  FOOTER

  @@map("nav_location")
}

model NavigationItem {
  id       String      @id @default(uuid(7)) @db.Uuid
  location NavLocation
  labelKa  String      @map("label_ka") @db.VarChar(40)
  labelEn  String?     @map("label_en") @db.VarChar(40)
  labelRu  String?     @map("label_ru") @db.VarChar(40)
  pageId   String?     @map("page_id") @db.Uuid
  url      String?     @db.VarChar(500)
  newTab   Boolean     @default(false) @map("new_tab")
  visible  Boolean     @default(true)
  position Int

  page Page? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([location, position])
  @@index([pageId])
  @@map("navigation_items")
}

// ─── Homepage slider (§3.11) ──────────────────────────────────────────────

model HomeSlide {
  id          String   @id @default(uuid(7)) @db.Uuid
  imageId     String   @map("image_id") @db.Uuid
  headingKa   String   @map("heading_ka") @db.VarChar(120)
  headingEn   String?  @map("heading_en") @db.VarChar(120)
  headingRu   String?  @map("heading_ru") @db.VarChar(120)
  textKa      String   @default("") @map("text_ka") @db.VarChar(300)
  textEn      String?  @map("text_en") @db.VarChar(300)
  textRu      String?  @map("text_ru") @db.VarChar(300)
  ctaLabelKa  String   @default("") @map("cta_label_ka") @db.VarChar(40)
  ctaLabelEn  String?  @map("cta_label_en") @db.VarChar(40)
  ctaLabelRu  String?  @map("cta_label_ru") @db.VarChar(40)
  ctaUrl      String   @default("") @map("cta_url") @db.VarChar(500)
  isPublished Boolean  @default(false) @map("is_published")
  position    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  image MediaAsset @relation(fields: [imageId], references: [id], onDelete: Restrict)

  @@index([isPublished, position])
  @@index([imageId])
  @@map("home_slides")
}

// ─── Redirects (§3.12) ────────────────────────────────────────────────────

model Redirect {
  id        String   @id @default(uuid(7)) @db.Uuid
  fromPath  String   @unique @map("from_path") @db.VarChar(300)
  toPath    String   @map("to_path") @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("redirects")
}

// ─── Email outbox (§3.6) ──────────────────────────────────────────────────

enum EmailStatus {
  pending
  sent
  failed

  @@map("email_status")
}

/// Inquiry emails waiting to be sent, retried with backoff until delivered (5 attempts).
/// Password-reset emails never go here: the payload would hold a usable reset link.
model EmailMessage {
  id            String      @id @default(uuid(7)) @db.Uuid
  recipient     String      @db.VarChar(254)
  template      String      @db.VarChar(40)
  locale        String      @default("ka") @db.VarChar(2)
  payload       Json
  status        EmailStatus @default(pending)
  attempts      Int         @default(0) @db.SmallInt
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?     @map("last_error") @db.VarChar(500)
  sentAt        DateTime?   @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("email_messages")
}
