# Copy to .env.local for local development.
# Where the API (server/) runs.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: the API address the Next.js server uses (e.g. a private network address).
# Defaults to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=

# The public address of this website, without a trailing slash. Used for canonical URLs,
# hreflang, Open Graph images, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Staging and preview deployments: 1 = every page is sent with "noindex, nofollow".
# Leave unset in production.
# SITE_NOINDEX=1

# Optional: Cloudflare Turnstile site key (public). When set, the contact form shows the spam check
# and sends its token; the API must then have the matching secret key.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
